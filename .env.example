# Public browser configuration. These values are embedded in the Vite bundle.
VITE_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-or-anon-key

# Public deployment capabilities returned by GET /api/v1/capabilities.
# These must match the real Supabase Auth configuration below; they are presentation flags, not
# security controls.
PUBLIC_REGISTRATION_ENABLED=true
PUBLIC_PASSWORD_RECOVERY_EMAIL_ENABLED=true
# Release version presented in settings ("About this deployment").
APP_VERSION=1.0.0

# API-only configuration. Never expose these values through VITE_* variables.
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-or-anon-key

# Supabase CLI local PostgreSQL connection. Replace every example secret in production.
# DATABASE_SSL must be true when connecting to Supabase Cloud or any TLS-enforcing database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# Supabase self-hosted Auth settings. These belong to the Auth service, not the web bundle.
# GOTRUE_DISABLE_SIGNUP must be the inverse of PUBLIC_REGISTRATION_ENABLED.
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_SITE_URL=http://127.0.0.1:5173
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:5173/update-password

# SMTP is required before setting PUBLIC_PASSWORD_RECOVERY_EMAIL_ENABLED=true outside local
# development. The Supabase CLI uses Mailpit locally instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME=Goal Tracker
