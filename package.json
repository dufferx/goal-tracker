{
  "name": "goal-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:packages": "pnpm --filter './packages/**' --if-present run build",
    "db:reset": "pnpm supabase db reset --local",
    "dev": "pnpm infra:start && pnpm dev:apps",
    "dev:apps": "pnpm build:packages && pnpm --parallel --filter @goal-tracker/web --filter @goal-tracker/api run dev",
    "dev:e2e": "pnpm build:packages && pnpm --parallel --filter @goal-tracker/web --filter @goal-tracker/api run dev:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:start": "pnpm supabase start",
    "infra:stop": "pnpm supabase stop",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build:packages && pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
